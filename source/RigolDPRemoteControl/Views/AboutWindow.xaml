<Window x:Class="RigolDPRemoteControl.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Rigol DP Remote Control" SizeToContent="Height" Width="560" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="22,20,22,18">
        <!-- title -->
        <DockPanel Margin="0,0,0,16">
            <Image DockPanel.Dock="Left" Source="/Assets/rigol_mark.png" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Rigol DP Remote Control" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" TextWrapping="Wrap"
                           Text="SCPI control and trending for Rigol DP700, DP800, DP900 and DP2000 power supplies"/>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21">
                    This application was written by <Bold>Wim Huyghe</Bold>, mainly with the help of AI tools, for my own personal use.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,10,0,0">
                    The source code is published under the <Hyperlink x:Name="LicenseLink" Click="Link_Click">MIT license</Hyperlink>.
                </TextBlock>
                <TextBlock x:Name="RepoLine" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,10,0,0">
                    Source code and downloads: <Hyperlink x:Name="RepoLink" Click="Link_Click"><Run x:Name="RepoText"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- disclaimer -->
        <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,2,14,0" VerticalAlignment="Top"/>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21">
                    No extended testing has been performed and no guarantees are offered for correct operation.
                    <Bold>Use this application at your own risk.</Bold>
                    <LineBreak/><LineBreak/>
                    This application has <Bold>no association with RIGOL</Bold>: it is not made, endorsed or supported by RIGOL Technologies.
                    <Run Foreground="{DynamicResource TextSecondary}" FontSize="12.5">RIGOL is a trademark of RIGOL Technologies.</Run>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- donation -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEB51;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource ErrorBrush}" Margin="0,2,14,0" VerticalAlignment="Top"/>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21">
                    If you like this application and would like to donate something, please make a donation to <Bold>any good cause of your own choice</Bold>.
                </TextBlock>
            </DockPanel>
        </Border>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsDefault="True" IsCancel="True"/>
            <TextBlock x:Name="CopyrightText" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</Window>
