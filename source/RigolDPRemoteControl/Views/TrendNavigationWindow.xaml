<Window x:Class="RigolDPRemoteControl.Views.TrendNavigationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trend navigation" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="18" MaxWidth="760">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
            <TextBlock Text="Trend navigation" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="12,8">
            <Grid x:Name="Table">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>
        <!-- non-modal window: IsCancel does not close it, so Close (and Esc) are handled in code -->
        <Button Content="Close" Width="90" IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
