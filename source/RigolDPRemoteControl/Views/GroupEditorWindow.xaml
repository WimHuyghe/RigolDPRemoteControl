<Window x:Class="RigolDPRemoteControl.Views.GroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channel group" Width="820" Height="600" MinWidth="640" MinHeight="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <Style x:Key="CellBox" TargetType="TextBox">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Group name" Style="{StaticResource Secondary}"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,4,0,12" MaxLength="40"/>
        <TextBlock Grid.Row="2" Style="{StaticResource Secondary}" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Tick the channels of this group (any power supply). Channel names and delays can be edited directly here; they are stored per channel."/>

        <!-- column headers -->
        <Grid Grid.Row="3" Margin="8,0,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Power supply / channel" Style="{StaticResource Secondary}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Channel name" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="4,0"/>
            <TextBlock Grid.Column="3" Text="On delay [s]" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="4,0"/>
            <TextBlock Grid.Column="4" Text="Off delay [s]" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="4,0"/>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChannelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="4" Padding="4,2" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" VerticalAlignment="Center"
                                              ToolTip="Member of this group"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="5" Height="18" RadiusX="2" RadiusY="2" Fill="{Binding Channel.ColorBrush}" Margin="0,0,8,0"/>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Channel.ScpiName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Channel.Device.Address, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Margin="4,1" VerticalAlignment="Center" MaxLength="40"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Margin="4,1" VerticalAlignment="Center" HorizontalContentAlignment="Right"
                                             Text="{Binding OnDelay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Margin="4,1" VerticalAlignment="Center" HorizontalContentAlignment="Right"
                                             Text="{Binding OffDelay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource OnBackground}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="5" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Switching the group ON switches every member on after its own on delay (counted from the moment ON is pressed); OFF uses the off delays. Example power sequence: core 0 s, I/O 0.5 s, motor 2 s."/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
