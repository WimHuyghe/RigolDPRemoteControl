<Window x:Class="RigolDPRemoteControl.Views.ChannelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channel settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="18" Width="420">
        <DockPanel Margin="0,0,0,12">
            <Rectangle x:Name="ColorBar" Width="6" Height="28" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Secondary}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Name (shown on the card and in the trend legend)" Style="{StaticResource Secondary}"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12" MaxLength="40"/>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                    <TextBlock Text="Switching delays" Style="{StaticResource SectionTitle}" FontSize="13"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Turn-on delay" VerticalAlignment="Center"/>
                    <TextBox x:Name="OnDelayBox" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="s" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Grid.Row="1" Text="Turn-off delay" VerticalAlignment="Center"/>
                    <TextBox x:Name="OffDelayBox" Grid.Row="1" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="s" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Delays are applied when the channel is switched as part of a group or with 'All on/off' of its supply (optionally also for the channel's own button, see Settings)."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                    <TextBlock Text="Protection (stored in the power supply)" Style="{StaticResource SectionTitle}" FontSize="13"/>
                </StackPanel>
                <Grid x:Name="ProtectionGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Over-voltage protection (OVP)" VerticalAlignment="Center"/>
                    <TextBox x:Name="OvpBox" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="V" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <CheckBox x:Name="OvpOn" Grid.Column="3" Content="On" VerticalAlignment="Center" MinWidth="0"/>
                    <TextBlock Grid.Row="1" Text="Over-current protection (OCP)" VerticalAlignment="Center"/>
                    <TextBox x:Name="OcpBox" Grid.Row="1" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <CheckBox x:Name="OcpOn" Grid.Row="1" Grid.Column="3" Content="On" VerticalAlignment="Center" MinWidth="0"/>
                </Grid>
                <TextBlock x:Name="ProtectionInfo" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <!-- delayed OVP / OCP enable after switching on (inrush current) -->
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="ProtDelayOn" Content="Delayed OVP/OCP enable after switching on" FontWeight="SemiBold"
                                  Checked="ProtDelayOn_Changed" Unchecked="ProtDelayOn_Changed"/>
                        <StackPanel x:Name="ProtDelayPanel" Margin="28,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Enable OVP/OCP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ProtDelayBox" Style="{StaticResource PlainTextBox}" Width="70" HorizontalContentAlignment="Right"/>
                                <TextBlock Text="s after channel switch on" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="When the output is switched off, OVP and OCP are switched off too. When it is switched on again, OVP/OCP are enabled (as ticked 'On' above) only after this delay – so the inrush current of the connected device cannot trip the protection."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="12">
                                <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"/>
                                <Run Text="The delay is not exact: communication with the power supply adds some time (typically 0.1–0.5 s, more over RS232). Switching on the front panel is noticed within about 1 s."/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                    <TextBlock Text="Show in trend" Style="{StaticResource SectionTitle}" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TrendV" Content="Voltage" Margin="0,0,16,0"/>
                    <CheckBox x:Name="TrendI" Content="Current" Margin="0,0,16,0"/>
                    <CheckBox x:Name="TrendP" Content="Power"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
