<Window x:Class="RigolDPRemoteControl.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="18" Width="480">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,10,0"/>
            <TextBlock Text="Application settings" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Extra pause between samples (0 = as fast as possible)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="PollBox" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Row="1" Text="Re-read setpoints / output state every" VerticalAlignment="Center"/>
                <TextBox x:Name="StatusBox" Grid.Row="1" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Row="2" Text="Command timeout" VerticalAlignment="Center"/>
                <TextBox x:Name="TimeoutBox" Grid.Row="2" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Row="3" Text="Default SCPI port" VerticalAlignment="Center"/>
                <TextBox x:Name="PortBox" Grid.Row="3" Grid.Column="1" Margin="0,2" HorizontalContentAlignment="Right"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="AutoTrend" Content="Start trend recording when the application starts" Margin="0,2"/>
                <CheckBox x:Name="SingleDelays" Content="Apply on/off delays also to a channel's own ON/OFF button" Margin="0,2"/>
                <CheckBox x:Name="GoLocal" Content="Return power supplies to local (front panel) control on exit" Margin="0,2"/>
                <CheckBox x:Name="ShowEnergy" Margin="0,2"
                          Content="Show a watt-hour counter (Wh) on each channel"
                          ToolTip="Adds an energy line (Wh delivered since the output was switched on) with a reset button below the power value of every channel card"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12">
            Settings are stored in <Run x:Name="SettingsPath" FontWeight="SemiBold"/>.
            Timeout/port changes are used for new connections (disconnect + connect to apply).
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
