<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds a compact RigolDPRemoteControl.exe (32-bit) that needs the .NET 10 Desktop Runtime (x86) on the target PC. No drivers needed.
  Visual Studio: right-click project > Publish > FrameworkDependent-win-x86 > Publish
  Command line:  dotnet publish -p:PublishProfile=FrameworkDependent-win-x86
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\win-x86-runtime\</PublishDir>
  </PropertyGroup>
</Project>
