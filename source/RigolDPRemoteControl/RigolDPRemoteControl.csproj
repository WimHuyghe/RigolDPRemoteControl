<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RigolDPRemoteControl</RootNamespace>
    <AssemblyName>RigolDPRemoteControl</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Rigol DP Remote Control</Product>
    <Description>Lightweight SCPI (LAN / RS232) controller for Rigol DP700, DP800, DP900 and DP2000 series power supplies</Description>
    <Version>1.0.0</Version>
    <Authors>Wim Huyghe</Authors>
    <Copyright>Copyright © 2026 Wim Huyghe – MIT license</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- WPF Fluent theme (ThemeMode) is flagged experimental in .NET 9/10 -->
    <!-- NU1701: SkiaSharp.Views.WPF (used by ScottPlot.WPF) only ships a .NET Framework build; it works fine on .NET -->
    <NoWarn>$(NoWarn);WPF0001;NU1701;CA2022</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <!-- managed serial port (RS232, needed for the DP700 series); part of .NET, no driver installation -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\rigol_mark.png" />
    <Resource Include="Assets\rigol_logo.png" />
    <None Update="Help\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- MIT license text next to the exe (linked from the About screen) -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
