<Window x:Class="RigolDPRemoteControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigolDPRemoteControl.ViewModels"
        xmlns:infra="clr-namespace:RigolDPRemoteControl.Infrastructure"
        xmlns:trend="clr-namespace:RigolDPRemoteControl.Trend"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Rigol DP Remote Control" Height="950" Width="1680" MinWidth="900" MinHeight="500"
        Icon="/RigolDPRemoteControl;component/Assets/app.ico"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>

        <!-- ================================================================ CHANNEL CARD -->
        <DataTemplate x:Key="ChannelCard" DataType="{x:Type vm:ChannelViewModel}">
            <Border x:Name="Card" Width="266" Margin="6" CornerRadius="8" BorderThickness="2" Padding="10,8"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- header: colour (= trend colour), channel, name, CV/CC badge, settings -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Rectangle DockPanel.Dock="Left" Width="5" Height="22" RadiusX="2" RadiusY="2" Fill="{Binding ColorBrush}"
                                   Margin="0,0,8,0" ToolTip="Trend colour of this channel"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE713;" Click="ChannelSettings_Click"
                                ToolTip="Channel settings: name, on/off delay, OVP/OCP, trend"/>
                        <Border DockPanel.Dock="Right" Style="{StaticResource ModeBadge}" Margin="4,0" VerticalAlignment="Center"
                                ToolTip="CV = constant voltage, CC = constant current, UR = unregulated">
                            <TextBlock Text="{Binding ModeText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Background="Transparent"
                                    MouseLeftButtonDown="ChannelName_MouseDown" Cursor="Hand" ToolTip="Double-click to rename">
                            <!-- channel number with its rating in brackets: "CH1 (30V / 3A)" -->
                            <TextBlock FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ScpiName, Mode=OneWay}"/>
                                <Run Text="{Binding RatingBracket, Mode=OneWay}" FontSize="11" FontWeight="Normal"
                                     Foreground="{DynamicResource TextSecondary}"/>
                            </TextBlock>
                            <!-- always occupies one line, so cards with and without a name have the same layout -->
                            <!-- only the name: delays and OVP/OCP settings are in the channel settings (gear button) -->
                            <TextBlock Height="16" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- actual values -->
                    <Grid Grid.Row="2" Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Actual" Style="{StaticResource Secondary}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MeasuredVoltageText}" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="V" Style="{StaticResource UnitText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeasuredCurrentText}" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="A" Style="{StaticResource UnitText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeasuredPowerText}" Style="{StaticResource ValueText}" FontSize="18"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="W" Style="{StaticResource UnitText}"/>
                        <!-- watt-hour counter (optional, application setting) -->
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource GhostButton}" Tag="&#xE72C;" Padding="4,1"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding ResetEnergyCommand}"
                                Visibility="{Binding Device.Main.ShowEnergy, Converter={StaticResource BoolToVis}}"
                                ToolTip="Reset the watt-hour counter to zero"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EnergyText}" Style="{StaticResource ValueText}" FontSize="16"
                                   Visibility="{Binding Device.Main.ShowEnergy, Converter={StaticResource BoolToVis}}"
                                   ToolTip="Energy delivered since the output was switched on (restarts at every switch-on; reset button on the left)"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding EnergyUnit}" Style="{StaticResource UnitText}" FontSize="11"
                                   Visibility="{Binding Device.Main.ShowEnergy, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- setpoints -->
                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Set" Style="{StaticResource Secondary}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" FontFamily="{StaticResource NumberFont}" FontSize="15"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding VoltageEditText, UpdateSourceTrigger=PropertyChanged}"
                                 infra:SetpointBox.ApplyCommand="{Binding ApplyVoltageCommand}"
                                 infra:SetpointBox.RevertCommand="{Binding RevertVoltageCommand}"
                                 infra:SetpointBox.IsEditing="{Binding IsEditingVoltage}"
                                 IsEnabled="{Binding Device.IsConnected}"
                                 ToolTip="Voltage setpoint – type a value and press Enter to apply (Esc cancels)"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="V" Style="{StaticResource UnitText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" FontFamily="{StaticResource NumberFont}" FontSize="15"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding CurrentEditText, UpdateSourceTrigger=PropertyChanged}"
                                 infra:SetpointBox.ApplyCommand="{Binding ApplyCurrentCommand}"
                                 infra:SetpointBox.RevertCommand="{Binding RevertCurrentCommand}"
                                 infra:SetpointBox.IsEditing="{Binding IsEditingCurrent}"
                                 IsEnabled="{Binding Device.IsConnected}"
                                 ToolTip="Current limit – type a value and press Enter to apply (Esc cancels)"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="A" Style="{StaticResource UnitText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- protection trip -->
                    <Border Grid.Row="4" Background="{DynamicResource ErrorBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,0,6"
                            Visibility="{Binding IsTripped, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,1" Command="{Binding ClearTripCommand}"/>
                            <TextBlock Foreground="White" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"/>
                                <Run Text="{Binding TripText, Mode=OneWay}"/> <Run Text="tripped"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- ON/OFF switch -->
                    <StackPanel Grid.Row="5">
                        <Button x:Name="PowerBtn" Command="{Binding ToggleOutputCommand}" Style="{StaticResource FlatButton}" Height="40"
                                ToolTip="Switch the output on/off">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OutputText}" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                Tag="&#xE916;" Content="{Binding PendingText}" Command="{Binding CancelPendingCommand}"
                                Foreground="{DynamicResource WarningBrush}" ToolTip="Delayed switching pending – click to cancel"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="12"
                                   ToolTip="Delayed protection: OVP/OCP are switched on after the configured delay (approximate – communication delays add some time)"
                                   Visibility="{Binding HasProtectionPending, Converter={StaticResource BoolToVis}}">
                            <Run Text="&#xE83D;" FontFamily="{StaticResource IconFont}"/> <Run Text="{Binding ProtectionPendingText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutputOn}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource OnBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource OnBackground}"/>
                    <Setter TargetName="PowerBtn" Property="Background" Value="{DynamicResource OnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Device.IsConnected}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ CHANNEL CARD – MINIMIZED VIEW -->
        <!-- output off: the setpoints are shown, output on: the actual values -->
        <DataTemplate x:Key="ChannelCardCompact" DataType="{x:Type vm:ChannelViewModel}">
            <Border x:Name="Card" Width="266" Margin="6,3" CornerRadius="8" BorderThickness="2" Padding="8,4,6,5"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}">
                <StackPanel>
                    <DockPanel>
                        <Rectangle DockPanel.Dock="Left" Width="5" Height="18" RadiusX="2" RadiusY="2" Fill="{Binding ColorBrush}"
                                   Margin="0,0,7,0" ToolTip="Trend colour of this channel"/>
                        <Button x:Name="PowerBtn" DockPanel.Dock="Right" Command="{Binding ToggleOutputCommand}" Style="{StaticResource FlatButton}"
                                Height="26" MinWidth="62" Padding="8,0" ToolTip="Switch the output on/off">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OutputText}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- only when on: when off the power button already says OFF -->
                        <Border x:Name="Badge" DockPanel.Dock="Right" Style="{StaticResource ModeBadge}" Margin="4,0" VerticalAlignment="Center"
                                Visibility="Collapsed" ToolTip="CV = constant voltage, CC = constant current, UR = unregulated">
                            <TextBlock Text="{Binding ModeText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent" Cursor="Hand"
                                   MouseLeftButtonDown="ChannelName_MouseDown" ToolTip="{Binding RatingBracket}">
                            <Run Text="{Binding ScpiName, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                            <Run Text="{Binding Name, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                    </DockPanel>

                    <Grid Margin="12,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Caption" Text="SET" Style="{StaticResource Secondary}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" ToolTip="Output off: setpoints are shown"/>
                        <!-- output off: the setpoints can be edited here too (Enter = apply, Esc = cancel) -->
                        <DockPanel x:Name="ValV" Grid.Column="1" Margin="0,0,4,0">
                            <TextBlock DockPanel.Dock="Right" Text="V" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            <TextBox Style="{StaticResource PlainTextBox}" FontFamily="{StaticResource NumberFont}" FontSize="13" MinHeight="24" Padding="3,1"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding VoltageEditText, UpdateSourceTrigger=PropertyChanged}"
                                     infra:SetpointBox.ApplyCommand="{Binding ApplyVoltageCommand}"
                                     infra:SetpointBox.RevertCommand="{Binding RevertVoltageCommand}"
                                     infra:SetpointBox.IsEditing="{Binding IsEditingVoltage}"
                                     IsEnabled="{Binding Device.IsConnected}"
                                     ToolTip="Voltage setpoint – type a value and press Enter to apply (Esc cancels)"/>
                        </DockPanel>
                        <DockPanel x:Name="ValA" Grid.Column="2" Margin="0,0,4,0">
                            <TextBlock DockPanel.Dock="Right" Text="A" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            <TextBox Style="{StaticResource PlainTextBox}" FontFamily="{StaticResource NumberFont}" FontSize="13" MinHeight="24" Padding="3,1"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding CurrentEditText, UpdateSourceTrigger=PropertyChanged}"
                                     infra:SetpointBox.ApplyCommand="{Binding ApplyCurrentCommand}"
                                     infra:SetpointBox.RevertCommand="{Binding RevertCurrentCommand}"
                                     infra:SetpointBox.IsEditing="{Binding IsEditingCurrent}"
                                     IsEnabled="{Binding Device.IsConnected}"
                                     ToolTip="Current limit – type a value and press Enter to apply (Esc cancels)"/>
                        </DockPanel>
                        <!-- actual values (output on) -->
                        <TextBlock x:Name="ActV" Grid.Column="1" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="14"
                                   FontWeight="SemiBold" Visibility="Collapsed">
                            <Run Text="{Binding MeasuredVoltageText, Mode=OneWay}"/><Run Text=" V" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                        <TextBlock x:Name="ActA" Grid.Column="2" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="14"
                                   FontWeight="SemiBold" Visibility="Collapsed">
                            <Run Text="{Binding MeasuredCurrentText, Mode=OneWay}"/><Run Text=" A" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                        <TextBlock x:Name="ActW" Grid.Column="3" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="14"
                                   Visibility="Hidden">
                            <Run Text="{Binding MeasuredPowerText, Mode=OneWay}"/><Run Text=" W" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                    </Grid>

                    <!-- protection trip / delayed switching (only when it applies) -->
                    <DockPanel Margin="0,3,0,0" Visibility="{Binding IsTripped, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="Clear" Padding="8,0" Command="{Binding ClearTripCommand}"/>
                        <TextBlock Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"/>
                            <Run Text="{Binding TripText, Mode=OneWay}"/> <Run Text="tripped"/>
                        </TextBlock>
                    </DockPanel>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Tag="&#xE916;" Content="{Binding PendingText}" Command="{Binding CancelPendingCommand}"
                            Foreground="{DynamicResource WarningBrush}" ToolTip="Delayed switching pending – click to cancel"
                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="11"
                               ToolTip="Delayed protection: OVP/OCP are switched on after the configured delay (approximate – communication delays add some time)"
                               Visibility="{Binding HasProtectionPending, Converter={StaticResource BoolToVis}}">
                        <Run Text="&#xE83D;" FontFamily="{StaticResource IconFont}"/> <Run Text="{Binding ProtectionPendingText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutputOn}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource OnBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource OnBackground}"/>
                    <Setter TargetName="PowerBtn" Property="Background" Value="{DynamicResource OnBrush}"/>
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Caption" Property="Text" Value="ACT"/>
                    <Setter TargetName="Caption" Property="ToolTip" Value="Output on: actual (measured) values are shown"/>
                    <Setter TargetName="ValV" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ValA" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ActV" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ActA" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ActW" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Device.IsConnected}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ DEVICE PANEL -->
        <DataTemplate x:Key="DevicePanel" DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource Card}" Margin="8,4,8,8">
                <StackPanel>
                    <!-- header: drag it out of the supply list to undock the supply (own window, always on top), drag it back to dock -->
                    <Border Background="{DynamicResource HeaderBackground}" CornerRadius="8,8,0,0" Padding="10,6" Tag="DragHeader"
                            MouseLeftButtonDown="PanelHeader_MouseDown" MouseMove="PanelHeader_MouseMove" MouseLeftButtonUp="PanelHeader_MouseUp"
                            LostMouseCapture="PanelHeader_LostMouseCapture">
                        <!-- three button groups: left = information / connection, middle = outputs, right = view -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                                <!-- fixed width, so the buttons of all supplies line up -->
                                <StackPanel VerticalAlignment="Center" Width="310" Background="Transparent" Cursor="SizeAll"
                                            ToolTip="Drag the header out of the supply list to show this supply in its own window (always on top). Drag it back onto the supply list to dock it again.">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusText}">
                                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        <Run Text="   "/>
                                        <Run Text="{Binding RateText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE946;" Content="Info" Click="DeviceInfo_Click" Margin="4,0,0,0"
                                        ToolTip="Model, manufacturer, serial number, MAC address, …"/>
                                <Button x:Name="ConnectBtn" Style="{StaticResource GhostButton}" Tag="&#xE703;" Content="Connect"
                                        Command="{Binding ConnectCommand}" ToolTip="Connect"/>
                                <Button x:Name="DisconnectBtn" Style="{StaticResource GhostButton}" Tag="&#xE8CD;" Command="{Binding DisconnectCommand}"
                                        ToolTip="Disconnect (front panel returns to local control)"/>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE72C;" Command="{Binding RefreshCommand}"
                                        ToolTip="Re-read setpoints / output states now"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton x:Name="CompactBtn" Style="{StaticResource GhostButton}" Tag="&#xE73F;" IsChecked="{Binding IsCompact}"
                                              ToolTip="Minimized view: one compact line per channel (setpoints when off, actual values when on)"/>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE70E;" Click="DeviceUp_Click" ToolTip="Move up"/>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE70D;" Click="DeviceDown_Click" ToolTip="Move down"/>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE74D;" Click="DeviceRemove_Click" ToolTip="Remove this power supply"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE7E8;" Content="All on" Command="{Binding AllOnCommand}"
                                        ToolTip="Switch all channels of this supply on (with delays)"/>
                                <Button Style="{StaticResource GhostButton}" Tag="&#xE711;" Content="All off" Command="{Binding AllOffCommand}"
                                        ToolTip="Switch all channels of this supply off (with delays)"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="ChannelList" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelCard}" Margin="4,2,4,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Margin="14,0,14,10" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Channels appear after the first successful connection."
                               Visibility="Collapsed" x:Name="NoChannels"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Connected}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OnBrush}"/>
                    <Setter TargetName="ConnectBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Connecting}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                    <Setter TargetName="ConnectBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Error}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Disconnected}">
                    <Setter TargetName="DisconnectBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Channels.Count}" Value="0">
                    <Setter TargetName="NoChannels" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter TargetName="ChannelList" Property="ItemTemplate" Value="{StaticResource ChannelCardCompact}"/>
                    <Setter TargetName="CompactBtn" Property="Tag" Value="&#xE740;"/>
                    <Setter TargetName="CompactBtn" Property="ToolTip" Value="Back to the full view (setpoint entry, actual and set values)"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- placeholder in the supply list for a supply that is shown in its own (floating) window -->
        <DataTemplate x:Key="DevicePlaceholder" DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource Card}" Margin="8,4,8,8" Padding="10,6" Opacity="0.85">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE8A7;" Content="Show" Click="FloatingShow_Click"
                                ToolTip="Bring the floating window of this supply to the front"/>
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE8A0;" Content="Dock" Click="FloatingDock_Click"
                                ToolTip="Put this supply back into the main window"/>
                    </StackPanel>
                    <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  –  in its own window (always on top)" Foreground="{DynamicResource TextSecondary}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Connected}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Connecting}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConnectionState.Error}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ GROUP ROW -->
        <DataTemplate x:Key="GroupRow" DataType="{x:Type vm:GroupViewModel}">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="8,5" Margin="0,3">
                <DockPanel>
                    <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Background="{DynamicResource OnBrush}" Command="{Binding OnCommand}"
                                Margin="2,0" Padding="12,4" ToolTip="Switch all channels of this group on (each after its on-delay)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="ON" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding OffCommand}" Margin="2,0" Padding="12,4"
                                ToolTip="Switch all channels of this group off (each after its off-delay)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="OFF" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE70F;" Click="GroupEdit_Click" ToolTip="Edit group"/>
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE74D;" Click="GroupDelete_Click" ToolTip="Delete group"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock Text="{Binding MembersText}" Style="{StaticResource Secondary}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MembersText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StateLevel}" Value="2">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLevel}" Value="1">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ CHANNEL GROUPS PANEL (main window or floating window) -->
        <DataTemplate x:Key="GroupsPanel" DataType="{x:Type vm:MainViewModel}">
            <Border Style="{StaticResource Card}" Margin="8,4,8,8" Padding="10,6">
                <StackPanel>
                    <!-- header: drag it out of the supply list to undock the groups (own window, always on top), drag it back to dock -->
                    <DockPanel Tag="DragHeader" Background="Transparent"
                               MouseLeftButtonDown="PanelHeader_MouseDown" MouseMove="PanelHeader_MouseMove" MouseLeftButtonUp="PanelHeader_MouseUp"
                               LostMouseCapture="PanelHeader_LostMouseCapture">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE710;" Content="New group"
                                Click="NewGroup_Click"/>
                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="SizeAll" HorizontalAlignment="Left"
                                    ToolTip="Drag the header out of the supply list to show the groups in their own window (always on top). Drag it back onto the supply list to dock them again.">
                            <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Channel groups" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4"
                               Text="No groups yet. A group switches a selection of channels (also of different supplies) on or off together, each channel after its own on/off delay."
                               Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupRow}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupsPlaceholder" DataType="{x:Type vm:MainViewModel}">
            <Border Style="{StaticResource Card}" Margin="8,4,8,8" Padding="10,6" Opacity="0.85">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE8A7;" Content="Show" Click="FloatingShow_Click"
                                ToolTip="Bring the floating window of the channel groups to the front"/>
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE8A0;" Content="Dock" Click="FloatingDock_Click"
                                ToolTip="Put the channel groups back into the main window"/>
                    </StackPanel>
                    <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Channel groups" FontWeight="SemiBold"/>
                        <Run Text="  –  in their own window (always on top)" Foreground="{DynamicResource TextSecondary}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <!-- three boxes: left = ALL OFF + adding supplies, middle = presets, right = view / settings / help.
                 Each box starts at its first command; the middle box fills the space between the other two. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolbarBox}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Background="{DynamicResource DangerButtonBackground}"
                            Click="AllOff_Click" ToolTip="Immediately switch OFF every output of every connected supply (no delays)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="ALL OFF" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource CardBorder}" Margin="14,4"/>
                    <TextBlock Text="IP / COM" Style="{StaticResource Secondary}" Margin="0,0,6,0"/>
                    <ComboBox Width="170" IsEditable="True" ItemsSource="{Binding RecentHosts}" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}"
                              KeyDown="HostBox_KeyDown" VerticalAlignment="Center"
                              ToolTip="IP address or host name (LAN: DP800, DP900, DP2000) or COM port (RS232: DP700, e.g. COM3). Use 'sim', 'sim-dp831', 'sim-dp711', 'sim-dp932', 'sim-dp2031' … for a simulated supply."/>
                    <TextBlock Text="Port / baud" Style="{StaticResource Secondary}" Margin="10,0,6,0"/>
                    <TextBox Width="62" Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             ToolTip="LAN: SCPI raw socket port (5555). COM port: baud rate (DP700 default 9600; 5555 is replaced by 9600)."/>
                    <Button Margin="8,0,0,0" ContentTemplate="{StaticResource IconText}" Tag="&#xE710;" Content="Add supply"
                            Click="AddDevice_Click" VerticalAlignment="Center"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolbarBox}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource GhostButton}" Tag="&#xE706;" Content="Dark mode"
                                  IsChecked="{Binding IsDarkMode}" ToolTip="Switch between dark and light mode"/>
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE713;" Content="Settings" Click="AppSettings_Click"
                            ToolTip="Application settings (sampling, timeouts, …)"/>
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE897;" Content="Help" Click="Help_Click"
                            ToolTip="User guide and datasheet summary of the supported power supplies (F1)"/>
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE946;" Content="About" Click="About_Click"
                            ToolTip="Version, author, license and disclaimer"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ToolbarBox}" Margin="6,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE8E5;" Content="Load preset" Click="LoadPreset_Click"
                            ToolTip="Load a complete configuration: supplies, channel names/delays, setpoints, OVP/OCP, groups and trend settings"/>
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE74E;" Content="Save preset" Click="SavePreset_Click"
                            ToolTip="Save the complete configuration (supplies, channel names/delays, setpoints, OVP/OCP, groups, trend settings, preset info) as a preset"/>
                    <Button Style="{StaticResource GhostButton}" Tag="&#xE70B;" Content="Preset info" Click="PresetInfo_Click"
                            ToolTip="Notes page for this setup (connections, wiring sketch, goal of the test) and a summary of the settings – saved in the preset"/>
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================ CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="860" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="SupplyPane" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,6,0,6">
                    <!-- groups (or a placeholder while they are shown in their own window) -->
                    <ContentControl Content="{Binding}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource GroupsPanel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupsFloating}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource GroupsPlaceholder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- empty state -->
                    <Border Style="{StaticResource Card}" Margin="8,4,8,8" Padding="16"
                            Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="No power supplies yet" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13">
                                Enter the IP address of a Rigol DP800, DP900 or DP2000 power supply in the toolbar and press <Bold>Add supply</Bold>.
                                The application connects with SCPI over a raw TCP socket (port 5555) – no VISA or other drivers are needed.
                                A DP700 (RS232 only) is added with its COM port, e.g. <Bold>COM3</Bold>, and the baud rate in the Port / baud field.
                                <LineBreak/><LineBreak/>
                                No instrument at hand? Add <Bold>sim</Bold> (or sim-dp831, sim-dp811, sim-dp711, sim-dp932, sim-dp2031) to try the application with a simulated supply.
                                <LineBreak/>
                                Or load a saved configuration with <Bold>Load preset</Bold>.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- devices, stacked vertically (a placeholder for supplies shown in their own window) -->
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="ContentTemplate" Value="{StaticResource DevicePanel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource DevicePlaceholder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- dock zone: shown while a floating supply / groups window is dragged over the supply list -->
            <Grid x:Name="DockHint" Grid.Column="0" Margin="6" IsHitTestVisible="False" Visibility="Collapsed">
                <Border CornerRadius="10" Background="{DynamicResource AccentBrush}" Opacity="0.15"/>
                <Border CornerRadius="10" BorderThickness="3" BorderBrush="{DynamicResource AccentBrush}"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A0;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DockHintText" Text="Release to dock here" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource CardBorder}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"/>

            <trend:TrendView x:Name="LiveTrend" Grid.Column="2"/>
        </Grid>

        <!-- ================================================================ STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="10,3">
            <DockPanel>
                <ToggleButton x:Name="LogToggle" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE81C;" Content="Log"
                              ToolTip="Show the message log"/>
                <Popup DockPanel.Dock="Right" IsOpen="{Binding IsChecked, ElementName=LogToggle}" PlacementTarget="{Binding ElementName=LogToggle}"
                       Placement="Top" StaysOpen="False" Closed="LogPopup_Closed" AllowsTransparency="True">
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="6" Width="700" MaxHeight="400">
                        <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="T" Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
